            {
              "letter": "A",
              "text": "Delegate financial authorization to the supplier",
              "justification": "to eliminate administrative oversight and accelerate troubleshooting."
            },
            {
              "letter": "B",
              "text": "Review the Business Case to confirm continued justification before authorizing an Exception Plan",
              "justification": "because under the directing a project process, the board must ensure continued business justification is preserved before allocating additional capital for exception recovery."
            },
            {
              "letter": "C",
              "text": "Hide the overrun within the informal Lessons Log",
              "justification": "to protect steering committee morale from viewing performance failures."
            },
            {
              "letter": "D",
              "text": "Take over day-to-day operational control of the technicians",
              "justification": "because the Executive holds supreme authority to perform technical fixes personally."
            }
          ],
          "correct_answer": "B",
          "citation": "PRINCE2 7 Manual, Chapter 6 (Business Case Practice) & Chapter 14 (Directing a Project Process)",
          "explain_correct": "The Project Board operates at the directing level. When a stage exception occurs, the board reviews the options. The Executive must verify that the project remains justified before authorizing an Exception Plan.",
          "explain_wrong": {
            "A": "The board cannot outsource funding authorization to the supplier.",
            "C": "Hiding overruns violates data management and transparency rules.",
            "D": "The Executive handles governance; they do not micromanage technical delivery."
          }
        },
